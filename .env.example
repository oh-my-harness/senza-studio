# Senza Studio — Environment Variables

# Meta-agent LLM configuration (Converser + Coding Agent)
# Also used as OPENAI_API_KEY for user agent subprocesses if OPENAI_API_KEY
# is not set explicitly.
STUDIO_API_KEY=your-api-key-here
STUDIO_MODEL=gpt-4o
STUDIO_BASE_URL=

# User agent LLM configuration (optional — falls back to STUDIO_* above)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=

# Studio run mode (set automatically by the runner)
# SENZA_STUDIO_RUN_ID=
# SENZA_STUDIO_TRACE_DIR=

# Server configuration
# SENZA_STUDIO_ADDR=0.0.0.0:3000
# SENZA_STUDIO_PROJECTS_DIR=./projects
# SENZA_STUDIO_FRONTEND_DIR=./frontend/dist
