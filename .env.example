# Senza Studio — Environment Variables

# Meta-agent LLM configuration (Converser + Coding Agent)
STUDIO_API_KEY=your-api-key-here
STUDIO_MODEL=gpt-4o
STUDIO_BASE_URL=

# User agent LLM configuration (inherited by generated projects)
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=

# Studio run mode (set automatically by the runner)
# SENZA_STUDIO_RUN_ID=
# SENZA_STUDIO_TRACE_DIR=
