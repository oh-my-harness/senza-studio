# Senza Studio — Environment Variables (all optional)
#
# API keys and LLM configuration are set via the Settings page in the UI.
# These environment variables are for server configuration only.

# Server listen address
# SENZA_STUDIO_ADDR=0.0.0.0:3000

# Where project files are stored
# SENZA_STUDIO_PROJECTS_DIR=./projects

# Path to settings JSON file (created on first save via Settings page)
# SENZA_STUDIO_SETTINGS_PATH=./settings.json

# Path to built frontend assets
# SENZA_STUDIO_FRONTEND_DIR=./frontend/dist
