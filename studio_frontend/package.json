{
  "name": "senza-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop workbench for building and operating Senza agents",
  "author": {
    "name": "oh-my-harness"
  },
  "desktopName": "SenzaStudio.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "electron:dev": "electron electron/main.cjs",
    "package:desktop": "bash ../scripts/package-desktop.sh",
    "package:desktop:linux": "bash ../scripts/package-desktop.sh linux"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "reactflow": "^11.11.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.ohmyharness.senza-studio",
    "productName": "Senza Studio",
    "afterPack": "electron/verify-pack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "../dist/desktop"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/desktop-resources",
        "to": "."
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "syncDesktopName": true,
      "artifactName": "senza-studio-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "forceCodeSigning": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "senza-studio-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": true,
      "artifactName": "senza-studio-${version}-${os}-${arch}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"]
      }
    },
    "nsis": {
      "runAfterFinish": false
    }
  }
}
